{
  "name": "disclose-chrome-extension",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "Browser extension that surfaces vulnerability-disclosure posture through the directory.disclose.io and lookup.disclose.io APIs.",
  "type": "module",
  "scripts": {
    "postinstall": "bunx playwright install chromium",
    "build": "bun scripts/build.ts",
    "test": "bun scripts/test.ts",
    "test:unit": "bun test test",
    "verify": "bun run test:unit && bunx tsc --noEmit && bun run build",
    "iterate": "bun scripts/build.ts && bun scripts/test.ts",
    "package": "bun scripts/package.ts",
    "package:check": "bun scripts/package.ts --check",
    "smoke": "SMOKE=1 bun scripts/test.ts",
    "demo": "bun scripts/demo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.2",
    "axe-core": "^4.12.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "tldts": "^7.4.10",
    "typescript": "^7.0.2"
  }
}
